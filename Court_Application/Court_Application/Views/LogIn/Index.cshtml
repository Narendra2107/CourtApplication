@{
}

<h2>Login</h2>
<form method="post" action="@Url.Action("Index", "Login")" style="max-width: 400px; margin: auto;">
    <div style="margin-bottom: 15px;">
        <label for="email" style="display: block; margin-bottom: 5px;">Email:</label>
        <input type="email" id="email" name="email" required style="width: 100%; padding: 8px; box-sizing: border-box;" />
    </div>
    <div style="margin-bottom: 15px;">
        <label for="password" style="display: block; margin-bottom: 5px;">Password:</label>
        <input type="password" id="password" name="password" required style="width: 100%; padding: 8px; box-sizing: border-box;" />
    </div>
    <div>
        <button type="submit" style="width: 100%; padding: 10px; background-color: #4CAF50; color: white; border: none; cursor: pointer;">Login</button>
    </div>
</form>
<div style="text-align: center; margin-top: 20px;">
    <a href="@Url.Action("Register", "Login")" style="color: #4CAF50;">Signup</a>
</div>
<div style="text-align: center; margin-top: 20px;">
    @if (ViewBag.Error != null)
    {
        <p style="color:red;">@ViewBag.Error</p>
    }
</div>