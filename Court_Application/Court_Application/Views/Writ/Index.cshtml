@model Court_Application.Models.Writ_Document
@{
	Layout = "_userLayout";
	ViewData["Title"] = "SuitDocument";
}

<div class="container mt-5">
	<div class="text-center mb-4">
		<h3 class="display-4">APPELLATE SIDE WRIT PACKAGE</h3>
	</div>
	<div class="text-left">
		@using (Html.BeginForm("DownloadWritFile", "document", FormMethod.Post))
		{
			<div class="form-group row">
				<label class="col-sm-2 col-form-label">Petitioner Address:</label>
				<div class="col-sm-10">
					@Html.TextAreaFor(Model => Model.Petitioner_Address, new { @class = "form-control" })
				</div>
			</div>
			<div class="form-group row">
				<label class="col-sm-2 col-form-label">Respondents Address:</label>
				<div class="col-sm-10">
					@Html.TextAreaFor(Model => Model.Respondents_Address, new { @class = "form-control" })
				</div>
			</div>
			<div class="form-group row">
				<label class="col-sm-2 col-form-label">Main Prayer:</label>
				<div class="col-sm-10">
					@Html.TextAreaFor(Model => Model.Main_Prayer, new { @class = "form-control" })
				</div>
			</div>
			<div class="form-group row">
				<label class="col-sm-2 col-form-label">Interfm Prayer:</label>
				<div class="col-sm-10">
					@Html.TextAreaFor(Model => Model.Interfm_Prayer, new { @class = "form-control" })
				</div>
			</div>
			<div class="form-group row">
				<label class="col-sm-2 col-form-label">1St Petitioner's Name:</label>
				<div class="col-sm-4">
					@Html.TextBoxFor(Model => Model.First_petioner_Name, new { @class = "form-control" })
				</div>
				<label class="col-sm-2 col-form-label">1St Respondent's Name:</label>
				<div class="col-sm-4">
					@Html.TextBoxFor(Model => Model.First_Respondents_Name, new { @class = "form-control" })
				</div>
			</div>
			<div class="form-group row">
				<label class="col-sm-2 col-form-label">District Name:</label>
				<div class="col-sm-4">
					@Html.TextBoxFor(Model => Model.District_Name, new { @class = "form-control" })
				</div>
				<label class="col-sm-2 col-form-label">Date of Filling:</label>
				<div class="col-sm-4">
					@Html.TextBoxFor(Model => Model.Date_of_Filling, new { @class = "form-control" })
				</div>
			</div>
			<div class="form-group row">
				<label class="col-sm-2 col-form-label">Verification:</label>
				<div class="col-sm-10">
					@Html.TextBoxFor(Model => Model.verification, new { @class = "form-control" })
				</div>
			</div>
			<div class="form-group row">
				<label class="col-sm-2 col-form-label">Lower Court Name:</label>
				<div class="col-sm-4">
					@Html.TextBoxFor(Model => Model.Lower_Court_Name, new { @class = "form-control" })
				</div>
				<label class="col-sm-2 col-form-label">Lower Court Case Number:</label>
				<div class="col-sm-4">
					@Html.TextBoxFor(Model => Model.Lower_Court_Case_Number, new { @class = "form-control" })
				</div>
			</div>
			<div class="form-group row">
				<label class="col-sm-2 col-form-label">Lower Court Order Date:</label>
				<div class="col-sm-4">
					@Html.TextBoxFor(Model => Model.Lower_Court_Order_Date, new { @class = "form-control" })
				</div>
			</div>
			<div class="form-group row">
				<label class="col-sm-2 col-form-label">Counsel Address:</label>
				<div class="col-sm-4">
					@Html.TextBoxFor(Model => Model.counsel_Address, new { @class = "form-control" })
				</div>
				<label class="col-sm-2 col-form-label">Counsel Code:</label>
				<div class="col-sm-4">
					@Html.TextBoxFor(Model => Model.counsel_Name, new { @class = "form-control" })
				</div>
			</div>
			<div class="form-group row">
				<label class="col-sm-2 col-form-label">Category:</label>
				<div class="col-sm-4">
					@Html.DropDownListFor(m => m.SelectedCategory, (List<SelectListItem>)ViewBag.Category, "Select Category", new { @class = "form-control" })
				</div>
				<label class="col-sm-2 col-form-label">Year:</label>
				<div class="col-sm-4">
					@Html.TextBoxFor(Model => Model.year, new { @class = "form-control" })
				</div>
			</div>
			<br />
			<input type="submit" value="Submit" class="btn btn-primary" />
			<input type="submit" value="Quit" class="btn btn-secondary" />
		}
	</div>
</div>